# ==============================================================================
# Road_Pool / RidePool AI - Frontend Environment Configuration
# ==============================================================================

# 1. Backend API & Realtime WebSocket URLs (Render Deployment or Local)
# Local development:
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/live
# Render Production Example:
# VITE_API_URL=https://roadpool-backend.onrender.com/api/v1
# VITE_WS_URL=wss://roadpool-backend.onrender.com/ws/live

# 2. Supabase Database & Realtime Configuration
# Get these from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Optional Firebase Authentication Configuration (If using Firebase auth)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id
